# Conexão ao Dev Workspace (URL+token ou ROOT local).
# Uso: skill / comando dev-workspace no Cursor/Claude — ver .cursor/skills/dev-workspace/

# DEV_WORKSPACE_ROOT=/path/to/dev-workspace
# DEV_WORKSPACE_URL=http://localhost:3010
# DEV_WORKSPACE_MCP_URL=http://localhost:3011/mcp
# DEV_WORKSPACE_API_TOKEN=   # token do consumidor (auto via register ou GET /api/projects/{id}/connection)

# Env do sistema (~/.zshrc) — install-kit auto-registra o repo no DW:
# export DEV_WORKSPACE_REGISTER_TOKEN=   # logs do container DW (install_token)
# export DEV_WORKSPACE_URL=http://localhost:3010
# export DEV_WORKSPACE_MCP_URL=http://localhost:3011/mcp
