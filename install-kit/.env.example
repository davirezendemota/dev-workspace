# Conexão ao Dev Workspace (URL+token ou ROOT local).
# Uso: skill / comando dev-workspace no Cursor/Claude — ver .cursor/skills/dev-workspace/

# DEV_WORKSPACE_ROOT=/path/to/dev-workspace
# DEV_WORKSPACE_URL=http://localhost:3010
# DEV_WORKSPACE_API_TOKEN=   # token do consumidor (GET /api/projects/{id}/connection no DW)
# Admin global (só DW/logs): não usar no repo consumidor
