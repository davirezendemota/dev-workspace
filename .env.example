# ============================================
# Variáveis de Ambiente - Workspace (Next.js fullstack)
# ============================================
#
# Copie este arquivo para .env e configure os valores
# cp .env.example .env
#

# ============================================
# Workspace (API routes do Next.js)
# ============================================
# Em desenvolvimento local (npm run dev), os defaults apontam para ./workspace_data
# No Docker, o compose monta ./workspace_data em /data:
WORKSPACE_CONFIG_PATH=./workspace_data/config.json
WORKSPACE_PROJECTS_PATH=./workspace_data/projects
WORKSPACE_AGENTS_PATH=./workspace_data/agents
WORKSPACE_PORT=80
# Raiz dos projetos locais (ex.: ~/workspace) — usado para resolver local_path em STATUS.md
# No Docker, o compose monta o diretório pai em /workspace
WORKSPACE_LOCAL_ROOT=../
