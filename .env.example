# Copie para .env e ajuste o caminho dos seus repos locais:
#   cp .env.example .env
#
# Portas fixas nos composes:
#   compose.yaml          → 3010 (dev)
#   compose.build.yaml    → 8080 (build local)
#   compose.production.yaml → 3000

# Pasta dos projetos locais no host — montada em /local-projects no Docker
WORKSPACE_LOCAL_PROJECTS_ROOT=/home/davi/workspace

# UID/GID do usuário do host — workspace_data fica gravável por agentes locais e pelo container
PUID=1000
PGID=1000

# Caminho do config no host (fora do Docker; dentro do container usa /data/config.json)
WORKSPACE_CONFIG_PATH=./workspace_data/config.json

# Opcional: fixar token da API manualmente.
# No Docker o token é gerado automaticamente no entrypoint e exibido nos logs do container.
# Fora do Docker use: npm run dev:host
# WORKSPACE_API_TOKEN=
