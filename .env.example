# ============================================
# Variáveis de Ambiente - Workspace (Next.js fullstack)
# ============================================
#
# Copie este arquivo para .env e configure apenas o que precisar:
# cp .env.example .env
#
# Todas as variáveis abaixo são opcionais.
#

# Porta exposta pelo Docker Compose (default: 3000)
# WORKSPACE_PORT=3000

# Caminho do config do workspace (default: ./workspace_data/config.json)
# WORKSPACE_CONFIG_PATH=./workspace_data/config.json

# Pasta dos projetos locais no host — montada em /local-projects no Docker
# WORKSPACE_LOCAL_PROJECTS_ROOT=/Users/davi/workspace
