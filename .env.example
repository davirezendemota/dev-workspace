# Copie para .env e ajuste o caminho dos seus repos locais:
#   cp .env.example .env
#
# Portas fixas nos composes:
#   compose.yaml          → 3010 app, 3011 MCP
#   compose.build.yaml    → 8080 app, 8082 MCP
#   compose.production.yaml → 3000 app, 3001 MCP

# Pasta dos projetos locais no host — montada em /local-projects no Docker
WORKSPACE_LOCAL_PROJECTS_ROOT=/home/davi/workspace

# UID/GID do usuário do host — workspace_data fica gravável por agentes locais e pelo container
PUID=1000
PGID=1000

# Caminho do config no host (fora do Docker; dentro do container usa /data/config.json)
WORKSPACE_CONFIG_PATH=./workspace_data/config.json

# Postgres + pgvector (IA de consulta / RAG)
POSTGRES_USER=dev_workspace
POSTGRES_PASSWORD=dev_workspace
POSTGRES_DB=dev_workspace
POSTGRES_PORT=5433
# Dentro do Docker Compose use host "postgres"; fora do Docker use localhost:5433
DATABASE_URL=postgresql://dev_workspace:dev_workspace@postgres:5432/dev_workspace

# Embeddings para RAG (openai; pode usar token separado do chat)
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_TOKEN=

# Opcional: fixar token da API manualmente.
# No Docker o token é gerado automaticamente no entrypoint e exibido nos logs do container.
# Fora do Docker use: npm run dev:host
# WORKSPACE_API_TOKEN=
